<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="pu_infra-jpa_IT">

        <!-- entities -->
        <class>com.kartaguez.bluepot.infrastructure.down.repository.jpa.entity.PotEntity</class>
        <class>com.kartaguez.bluepot.infrastructure.down.repository.jpa.entity.PotGlobalVersionEntity</class>
        <class>com.kartaguez.bluepot.infrastructure.down.repository.jpa.entity.PotShareholderEntity</class>

        <properties>
            <!-- H2 with init -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:pocoma-test;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM 'classpath:db_schema.sql'\;RUNSCRIPT FROM 'classpath:tests_dataset.sql'"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Hibernate -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
